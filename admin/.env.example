# 高德 JS API Key（Web端）。控制台需勾选「Web端(JS API)」，
# 并在安全密钥里配置 securityJsCode，或把 localhost 加入 Referer 白名单。
VITE_AMAP_KEY=your_amap_web_key
VITE_AMAP_SECURITY_CODE=your_amap_security_js_code
# Optional: API origin when running Vite alone (empty = same origin / embedded)
# VITE_API_BASE=http://127.0.0.1:8080
# Force AMap same-origin proxy outside Vite DEV (embedded admin on :8080 auto-enables)
# VITE_AMAP_PROXY=1
